# ── Abhängigkeiten ────────────────────────────────────────────────────────
node_modules/
venv/
__pycache__/
*.pyc

# ── Bauergebnisse ─────────────────────────────────────────────────────────
# dist/ wird von deploy.sh erzeugt und liegt auf dem Server; es gehört nicht
# in die Versionierung, sonst wäre jeder Build ein Diff über 19 MB.
dist/
Kapbeni_Prod/_dist_backups/
Kapbeni_Prod/src/dist_backup_pre-live-1zu1/

# ── Sicherungskopien aus der Handarbeit ───────────────────────────────────
*.bak
*.bak_*
*_backup_*

# ── Geheimnisse — gehören ausschließlich nach /etc/kapbeni.env ────────────
# Hier steht keines dieser Muster, der Eintrag ist eine Sperre für die Zukunft.
.env
.env.*
*.env
!*.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*_deploy
*_deploy.pub

# ── Laufzeit ──────────────────────────────────────────────────────────────
*.log
logs/
.pm2/
*.pid
.DS_Store
